# Required core settings
FLASK_SECRET_KEY=change-me-generate-a-long-random-secret
GEMINI_API_KEY=change-me-google-ai-studio-api-key
DATABASE_URL=postgresql://lpms_user:change-me@127.0.0.1:5432/lpms

# Runtime mode
FLASK_DEBUG=False
SESSION_COOKIE_SECURE=True

# Public URLs and file storage
PUBLIC_APP_URL=https://your-domain.example.com
LPMS_STORAGE_ROOT=/home/your-user/lpms/local_storage
STORAGE_BUCKET_NAME=clp_files

# ONLYOFFICE document server
ONLYOFFICE_API_JS_URL=https://onlyoffice.your-domain.example.com/web-apps/apps/api/documents/api.js
ONLYOFFICE_CALLBACK_URL=https://your-domain.example.com
ONLYOFFICE_INTERNAL_APP_URL=http://127.0.0.1:3000
ONLYOFFICE_JWT_SECRET=change-me-match-onlyoffice-jwt-secret
ONLYOFFICE_FORCE_AI_PLUGIN_SETTINGS=false
ONLYOFFICE_FORCE_AI_PLUGIN_MODEL_OVERRIDES=false

# Optional AI provider
DEEPSEEK_API_KEY=

# Optional Tiptap document conversion/collaboration
TIPTAP_CONVERT_APP_ID=
TIPTAP_CONVERT_SECRET=
TIPTAP_CONVERT_BASE_URL=https://api.tiptap.dev/v2/convert
TIPTAP_DOCUMENT_SERVER_ID=
TIPTAP_DOCUMENT_SERVER_SECRET=
TIPTAP_DOCUMENT_SERVER_API_SECRET=
TIPTAP_DOCUMENT_SERVER_BASE_URL=

# Optional license controls
LOUIS_LICENSE_KEY=
LOUIS_LICENSE_API=
LOUIS_LICENSE_ENFORCEMENT_ENABLED=false

# Optional local migration helper
LOCAL_MIGRATION_DEFAULT_PASSWORD=

# Legacy/compatibility placeholders; local mode does not require real Supabase keys.
SUPABASE_URL=
SUPABASE_KEY=local
SUPABASE_SERVICE_KEY=local-service

